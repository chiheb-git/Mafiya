{
  "expo": {
    "name": "MAFIA Mobile",
    "slug": "mafia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mafia-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111417"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mafiagame.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MAFIA a besoin du micro pour la communication vocale pendant les parties."
      }
    },
    "android": {
      "package": "com.mafiagame.mobile",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#111417"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "MAFIA a besoin du micro pour la communication vocale pendant les parties."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2302991e-55b6-4934-80fa-8d5a322fd90c"
      }
    }
  }
}
